# 1단계: 빌드
FROM node:20-alpine AS build
WORKDIR /app
COPY Frontend/package*.json ./
RUN npm ci || npm install
COPY Frontend/ ./
RUN npm run build

# 2단계: Nginx 서빙
FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY Frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
